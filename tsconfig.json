{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // Legacy SF Pi business schemas use the extension StringEnum/TypeBox
    // view. OMP's native UI APIs resolve through their own package exports.
    "paths": {
      "@earendil-works/pi-ai": [
        "./node_modules/@earendil-works/pi-coding-agent/dist/core/extensions/pi-ai-extension-view.d.ts"
      ]
    }
  },
  "include": ["extensions/**/*.ts", "catalog/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
